# Copiá como .env.local (local) y cargá las mismas en Vercel → Settings → Environment Variables.
# Sin estas dos, el sitio funciona igual con los 50 productos de ejemplo (data/productos.json).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# la ANON key (pública). NUNCA la service_role acá: todo lo NEXT_PUBLIC_ llega al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública del sitio (para SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://texma.com.ar
# Dónde vive la PWA de TEXMA (el otro proyecto de Vercel)
NEXT_PUBLIC_PWA_URL=https://texma-planner.vercel.app

# SOLO SERVIDOR (sin NEXT_PUBLIC_): la usan /api/admin/* y /api/tickets.
# La service_role de Supabase → Project Settings → API. Nunca al repo.
SUPABASE_SERVICE_ROLE=

# MAIL (solo servidor) · tickets de soporte: aviso al negocio y respuestas al cliente.
# Gmail de TEXMA con una «contraseña de aplicación» (Cuenta de Google → Seguridad →
# Verificación en 2 pasos → Contraseñas de aplicaciones). NO es la clave de la cuenta.
SMTP_USER=texma.ok@gmail.com
SMTP_PASS=
# opcionales: SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · MAIL_AVISOS=adonde-llegan-los-avisos@gmail.com
