# Copiá como .env.local (local) y cargá las mismas en Vercel → Settings → Environment Variables.
# Sin estas dos, el sitio funciona igual con los 50 productos de ejemplo (data/productos.json).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# la ANON key (pública). NUNCA la service_role acá: todo lo NEXT_PUBLIC_ llega al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública del sitio (para SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://texma.com.ar
# Dónde vive la PWA de TEXMA (el otro proyecto de Vercel)
NEXT_PUBLIC_PWA_URL=https://texma.vercel.app
