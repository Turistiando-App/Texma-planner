{
  "appId": "app.maxingagent.texma",
  "appName": "TEXMA",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#EC1968"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_texma",
      "iconColor": "#EC1968",
      "sound": "notif_texma"
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#EC1968",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#EC1968"
    }
  }
}
