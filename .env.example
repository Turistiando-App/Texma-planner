# Copiá este archivo como `.env` (queda fuera del git) y completá.
# `vercel dev` lo lee solo. En producción, las mismas variables se cargan en
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# la service_role puede ESCRIBIR salteando el RLS: solo en tu máquina y en Vercel, nunca en una app
SUPABASE_SERVICE_ROLE=eyJ...

# Contraseña del panel /admin (en producción usá una larga y distinta)
ADMIN_PASS=cambiame

# Clave PRIVADA de firma de licencias, en una sola línea (sale de: node server/keygen.mjs)
# Tiene que ser la pareja de LIC_PUB de TEXMA.html, si no las licencias no validan.
LIC_PRIV='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}'

# Opcionales
# APP_ID=texma
# APP_URL=https://texma.vercel.app/     (por defecto: el mismo sitio)
# APK_URL=                             (respaldo si la tabla apps no tiene APK)
